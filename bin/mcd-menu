#!/system/bin/sh
# Compact Russian mobile menu.

MODDIR=${0%/*}
MCD="$MODDIR/mcd-ctrl"

clear_screen() {
    command -v clear >/dev/null 2>&1 && clear 2>/dev/null || :
}

pause_menu() {
    printf '\nEnter - продолжить: '
    IFS= read -r _ || return 1
}

run_and_pause() {
    printf '\n'
    if [ "$1" = "$MCD" ]; then
        shift
        sh "$MCD" "$@"
    else
        "$@"
    fi
    pause_menu || exit 0
}

read_choice() {
    printf '\nВыберите: '
    IFS= read -r MENU_CHOICE
}

show_main_menu() {
    title=$(sh "$MCD" version 2>/dev/null)
    [ -n "$title" ] || title="Module Conflict Detector"
    printf '%s\n\n' "$title"
    cat <<'MENU'
1. Быстрая проверка
2. Полная проверка
3. Расширенное меню
0. Выход
MENU
}

show_advanced_menu() {
    clear_screen
    cat <<'MENU'
Расширенное меню

1. Последний отчёт
2. Только критические
3. Объяснить находку
4. Baseline
5. Экспорт с редактированием
6. Статус автозапуска
7. Диагностика модуля
8. Настройки
9. Самопроверка
10. Исключения
11. Снимки
12. Техническая справка
0. Назад
MENU
}

baseline_menu() {
    clear_screen
    cat <<'MENU'
Baseline

1. Создать
2. Сравнить
3. Последняя разница
4. Показать исходный baseline
5. Сбросить
0. Назад
MENU
    read_choice || return 1
    case "$MENU_CHOICE" in
        1) run_and_pause "$MCD" baseline create ;;
        2) run_and_pause "$MCD" baseline compare ;;
        3) run_and_pause "$MCD" baseline show ;;
        4) run_and_pause "$MCD" baseline raw ;;
        5) run_and_pause "$MCD" baseline reset ;;
        *) return 0 ;;
    esac
}

whitelist_menu() {
    clear_screen
    cat <<'MENU'
Исключения

1. Показать
2. Добавить цель
3. Удалить цель
0. Назад
MENU
    read_choice || return 1
    case "$MENU_CHOICE" in
        1) run_and_pause "$MCD" whitelist list ;;
        2)
            printf 'Цель: '
            IFS= read -r target || return 1
            [ -n "$target" ] && run_and_pause "$MCD" whitelist add "$target"
            ;;
        3)
            printf 'Цель: '
            IFS= read -r target || return 1
            [ -n "$target" ] && run_and_pause "$MCD" whitelist remove "$target"
            ;;
        *) return 0 ;;
    esac
}

snapshot_menu() {
    clear_screen
    cat <<'MENU'
Снимки

1. Создать
2. Список
3. Сравнить
4. Удалить
0. Назад
MENU
    read_choice || return 1
    case "$MENU_CHOICE" in
        1)
            printf 'Имя (необязательно): '
            IFS= read -r name || return 1
            if [ -n "$name" ]; then
                run_and_pause "$MCD" snapshot create "$name"
            else
                run_and_pause "$MCD" snapshot create
            fi
            ;;
        2) run_and_pause "$MCD" snapshot list ;;
        3)
            printf 'Имя: '
            IFS= read -r name || return 1
            [ -n "$name" ] && run_and_pause "$MCD" snapshot compare "$name"
            ;;
        4)
            printf 'Имя: '
            IFS= read -r name || return 1
            [ -n "$name" ] && run_and_pause "$MCD" snapshot delete "$name"
            ;;
        *) return 0 ;;
    esac
}

toggle_setting() {
    key="$1"
    current=$(sh "$MCD" config get "$key" 2>/dev/null)
    [ "$current" = "1" ] && next=0 || next=1
    run_and_pause "$MCD" config set "$key" "$next"
}

settings_menu() {
    while :; do
        clear_screen
        cat <<'MENU'
Настройки

1. Показать настройки
2. Автосканирование при загрузке
3. Сравнение с baseline
4. Скрипты в полной проверке
5. overlay.d в полной проверке
6. sepolicy в полной проверке
7. Непроверенный priority
8. Задержка автосканирования
0. Назад
MENU
        read_choice || return 1
        case "$MENU_CHOICE" in
            1) run_and_pause "$MCD" config list ;;
            2) toggle_setting auto_scan ;;
            3) toggle_setting baseline_compare_on_scan ;;
            4) toggle_setting script_scan ;;
            5) toggle_setting overlayd_scan ;;
            6) toggle_setting sepolicy_scan ;;
            7)
                echo 'Внимание: priority не стандартизирован.'
                toggle_setting trust_module_priority
                ;;
            8)
                printf 'Задержка в секундах: '
                IFS= read -r delay || return 1
                case "$delay" in
                    ''|*[!0-9]*) echo 'Неверное число'; sleep 1 ;;
                    *) run_and_pause "$MCD" config set boot_delay_seconds "$delay" ;;
                esac
                ;;
            0) return 0 ;;
            *) echo 'Неверный пункт'; sleep 1 ;;
        esac
    done
}

advanced_menu() {
    while :; do
        show_advanced_menu
        read_choice || return 1
        case "$MENU_CHOICE" in
            1) run_and_pause "$MCD" report ;;
            2) run_and_pause "$MCD" report --critical-only ;;
            3)
                printf 'ID (MCD-...): '
                IFS= read -r id || return 1
                [ -n "$id" ] && run_and_pause "$MCD" explain "$id"
                ;;
            4) baseline_menu || return 1 ;;
            5) run_and_pause "$MCD" export --redact ;;
            6) run_and_pause "$MCD" boot-status ;;
            7) run_and_pause "$MCD" doctor ;;
            8) settings_menu || return 1 ;;
            9) run_and_pause "$MCD" self-test ;;
            10) whitelist_menu || return 1 ;;
            11) snapshot_menu || return 1 ;;
            12) run_and_pause "$MCD" help-all ;;
            0) return 0 ;;
            *) echo 'Неверный пункт'; sleep 1 ;;
        esac
    done
}

while :; do
    clear_screen
    show_main_menu
    if ! read_choice; then
        echo 'Ввод недоступен. Запускаю полную проверку.'
        exec sh "$MCD" scan --deep
    fi
    case "$MENU_CHOICE" in
        1) run_and_pause "$MCD" scan ;;
        2) run_and_pause "$MCD" scan --deep ;;
        3) advanced_menu || exit 0 ;;
        0) exit 0 ;;
        *) echo 'Неверный пункт'; sleep 1 ;;
    esac
done
